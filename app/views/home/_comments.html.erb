<div class="l-comments">
  <h2>Comentarios del Curso</h2>

  <div class="comments-list">
    <% course.comments.each do |comment| %>
      <div class="comment">
        <div class="comment-header">
          <div class="avatar">
            <%= comment.name.first.upcase %>
          </div>

          <div class="author">
            <h4><%= comment.name %></h4>
            <span><%= comment.created_at.strftime('%d/%m/%Y %H:%M') %></span>
          </div>

          <% if admin_signed_in? %>
            <%= link_to 'Eliminar',
                        course_comment_path(course, comment),
                        method: :delete,
                        data: { confirm: '¿Eliminar comentario?' },
                        class: 'delete-link' %>
          <% end %>
        </div>

        <p><%= comment.body %></p>
      </div>
    <% end %>
  </div>

  <h3>Dejá tu comentario</h3>

  <div class="comment-form">
    <%= form_for [course, Comment.new], url: course_comments_path(course) do |f| %>

      <div class="form-group">
        <%= f.label :name, 'Nombre' %>
        <%= f.text_field :name, class: 'form-control', required: true %>
      </div>

      <div class="form-group">
        <%= f.label :email, 'Email' %>
        <%= f.email_field :email, class: 'form-control', required: true %>
      </div>

      <div class="form-group">
        <%= f.label :body, 'Comentario' %>
        <%= f.text_area :body, class: 'form-control', required: true %>
      </div>

      <div class="form-group recaptcha-container">
        <%= recaptcha_tags %>
      </div>

      <%= f.submit 'Enviar comentario', class: 'button' %>
    <% end %>
  </div>
</div>
