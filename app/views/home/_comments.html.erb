<div class="l-comments">
  <h2>Comentarios</h2>

  <% Comment.all.each do |comment| %>
    <div class="comment">
      <div class="comment-header">
        <h4><%= comment.name %> (<%= comment.email %>)</h4>
        <div class="comment-meta">
          <%= comment.created_at.strftime('%d/%m/%Y %H:%M') %>
          <% if admin_signed_in? %>
            <%= link_to 'Eliminar', comment_path(comment), method: :delete, data: { confirm: '¿Estás seguro de que quieres eliminar este comentario?' }, class: 'delete-link' %>
          <% end %>
        </div>
      </div>
      <p><%= comment.body %></p>
    </div>
  <% end %>

  <h3>Deja tu comentario</h3>
  <div class="comment-form">
    <%= form_for Comment.new, url: comments_path do |f| %>
      <div class="form-group">
        <%= f.label :name, 'Nombre' %>
        <%= f.text_field :name, class: 'form-control' %>
      </div>
      <div class="form-group">
        <%= f.label :email, 'Email' %>
        <%= f.email_field :email, class: 'form-control' %>
      </div>
      <div class="form-group">
        <%= f.label :body, 'Comentario' %>
        <%= f.text_area :body, class: 'form-control' %>
      </div>
      <div class="form-group recaptcha-container">
        <%= recaptcha_tags %>
      </div>
      <%= f.submit 'Enviar', class: 'button' %>
    <% end %>
  </div>
</div>