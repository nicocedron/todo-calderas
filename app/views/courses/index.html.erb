<% content_for :title, t('views.courses.index.title') %>

<div class="container padding-base">
<% if posts.any? %>
  <div class="row">
    <% posts.each do |post| %>
      <div class="col-50">
        <%= render 'shared/post-mini', post: post %>
      </div>
    <% end %>
  </div>

  <div class="center-text">
    <%= paginate posts, window: 5 %>
  </div>
<% else %>
  <p>No hay cursos disponibles por el momento.</p>
<% end %>

</div>
